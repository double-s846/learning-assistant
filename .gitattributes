# 统一换行符，避免 Windows / macOS 协作时整文件 diff
* text=auto eol=lf

# 明确的二进制类型
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary

# Windows 脚本保留 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# 锁文件不参与语言统计
package-lock.json linguist-generated=true
