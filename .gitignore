# ---- 依赖与构建产物 ----
node_modules/
dist/
dist-ssr/
*.local

# ---- 本地包管理器缓存（勿提交）----
.npm-cache/
.pnpm-store/

# ---- 环境变量：只提交 .env.example ----
.env
.env.*
!.env.example

# ---- 日志 ----
*.log
npm-debug.log*
pnpm-debug.log*

# ---- 编辑器 / 操作系统 ----
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# ---- 演示与导出临时文件 ----
/coverage/
/playwright-report/
/docs/_screenshots/*.tmp.png
